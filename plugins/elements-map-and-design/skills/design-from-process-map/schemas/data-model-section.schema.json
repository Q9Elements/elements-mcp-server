{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data model section (data-model-deriver)",
  "description": "Entities and relationships in the business-architecture model's own shape (schemas/ba-model.schema.json at the plugin root), plus the fields only this playbook uses: sourceNouns, steps and nodeId on entities, steps on relationships, and areas.",
  "type": "object",
  "required": ["entities", "relationships", "gaps"],
  "additionalProperties": false,
  "properties": {
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "sourceNouns", "steps", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "kind": {"enum": ["standard", "custom", "external", "proposed"]},
          "sourceNouns": {"description": "The nouns and resources of the source map this entity was derived from.", "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
          "steps": {"description": "Ids of the model's activities that use this entity.", "type": "array", "minItems": 1, "items": {"type": "string"}},
          "nodeId": {"description": "The org object's node id, copied from the evidence, when the entity maps to an org object.", "type": "string", "pattern": "^[a-fA-F0-9]{24}$"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 1000}}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "cardinality"],
        "properties": {
          "steps": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "areas": {
      "description": "Only when there are more entities than the readability rubric's R30 threshold: one data model diagram per area.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "entities"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 60},
          "entities": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "gaps": {"type": "array", "items": {"type": "object", "required": ["note"]}}
  }
}
